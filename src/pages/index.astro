---
import { getCollection, render } from 'astro:content';
import EntryList from '../components/EntryList.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { projects } from '../data/projects';
import { byDateDesc, collectTags, isPublicEntry } from '../lib/content';
import { site } from '../lib/site';
import { withBase } from '../lib/url';

const wiki = (await getCollection('wiki')).filter(isPublicEntry).sort(byDateDesc);
const home = (await getCollection('pages')).find((entry) => entry.id === 'home' && entry.data.visibility === 'public' && !entry.data.draft);
if (!home) throw new Error('Missing public page: home');
const topics = collectTags(wiki).slice(0, 10);
const { Content } = await render(home);
---

<BaseLayout title={site.title} description={home.data.description || site.description}>
  <section class="grid gap-10 lg:grid-cols-[1.1fr_0.9fr]">
    <div>
      <p class="cyber-eyebrow text-sm font-medium">{home.data.eyebrow || `${site.role} / public notebook`}</p>
      <h1 class="cyber-title mt-3 max-w-3xl whitespace-pre-line text-4xl font-black leading-tight sm:text-5xl">
        {home.data.heading ?? home.data.title}
      </h1>
      <p class="cyber-copy mt-5 max-w-2xl text-base leading-7">
        {home.data.summary}
      </p>
    </div>

    <aside class="cyber-panel p-5">
      <img
        src={withBase('/profile.jpg')}
        alt={home.data.imageAlt || `${site.author} profile photo`}
        class="cyber-frame mb-6 aspect-[3/4] w-full max-w-xs object-cover object-[52%_45%]"
        decoding="async"
        loading="eager"
      />
      <h2 class="cyber-eyebrow text-sm font-semibold">About</h2>
      <div class="prose prose-zinc mt-3 text-sm leading-6">
        <Content />
      </div>
      <div class="mt-4 flex flex-wrap gap-3 text-sm">
        {site.contacts.map((contact) => <a href={contact.href}>{contact.label}</a>)}
      </div>
      <a class="mt-4 inline-block text-sm font-medium" href={withBase('/about/')}>Read more</a>
    </aside>
  </section>

  <section class="mt-14 grid gap-10 lg:grid-cols-[1fr_18rem]">
    <div>
      <div class="mb-4 flex items-end justify-between gap-4">
        <h2 class="cyber-section-title text-xl font-semibold">Latest Wiki Notes</h2>
        <a class="text-sm" href={withBase('/wiki/')}>All notes</a>
      </div>
      <EntryList entries={wiki.slice(0, 3)} />
    </div>

    <div>
      <h2 class="cyber-section-title text-xl font-semibold">Wiki Topics</h2>
      <div class="mt-4 flex flex-wrap gap-2">
        {topics.map((tag) => <a class="cyber-tag px-2 py-1 text-sm" href={withBase('/wiki/')}>#{tag}</a>)}
      </div>
    </div>
  </section>

  <section class="mt-14">
    <div class="mb-4 flex items-end justify-between gap-4">
      <h2 class="cyber-section-title text-xl font-semibold">Projects</h2>
      <a class="text-sm" href={withBase('/projects/')}>All projects</a>
    </div>
    <div class="grid gap-4 md:grid-cols-3">
      {projects.slice(0, 3).map((project) => (
        <article class="cyber-card p-4">
          <p class="cyber-meta text-xs font-medium">{project.status}</p>
          <h3 class="cyber-entry-link mt-2 font-semibold">{project.displayTitle ?? project.title}</h3>
          <p class="cyber-copy mt-2 text-sm leading-6">{project.description}</p>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
