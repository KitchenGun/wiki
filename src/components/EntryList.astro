---
import { entryHref, formatDate } from '../lib/content';
import { withBase } from '../lib/url';

const { entries } = Astro.props;
---

<div class="cyber-list divide-y divide-zinc-800">
  {entries.map((entry) => (
    <article class="cyber-list-item grid gap-2 py-5 sm:grid-cols-[9rem_1fr]">
      <time class="cyber-meta text-sm">{formatDate(entry.data.date)}</time>
      <div>
        <a class="cyber-entry-link text-base font-semibold" href={withBase(entryHref(entry))}>
          {entry.data.title}
        </a>
        {entry.data.description && <p class="cyber-copy mt-1 text-sm leading-6">{entry.data.description}</p>}
        {entry.data.tags.length > 0 && (
          <div class="mt-2 flex flex-wrap gap-2">
            {entry.data.tags.map((tag) => <span class="cyber-mini-tag px-2 py-0.5 text-xs">#{tag}</span>)}
          </div>
        )}
      </div>
    </article>
  ))}
</div>
